<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.ireport</groupId>
    <artifactId>ireport-parent</artifactId>
    <version>6.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ireport-parent</name>
    
    <!-- this was taken from the original project --> 
    <licenses>
        <license>
            <name>GNU AFFERO GENERAL PUBLIC LICENSE, Version 3 (AGPL-3.0)</name>
            <url>http://opensource.org/licenses/AGPL-3.0</url>
        </license>
    </licenses>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.netbeans.utilities</groupId>
                    <artifactId>nbm-maven-plugin</artifactId>
                    <version>4.8</version>
                    <extensions>true</extensions>
                    <configuration>
                        <brandingToken>${brandingToken}</brandingToken>
                        <cluster>${brandingToken}</cluster>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <release>17</release>
                    <proc>full</proc>
                    <compilerArgs><arg>-Xmaxerrs</arg><arg>1000</arg></compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.0</version>
                <configuration><argLine>--add-opens=java.base/java.net=ALL-UNNAMED -Dgroovy.target.bytecode=17 -Dgroovy.target.indy=false</argLine><systemPropertyVariables>
                    <netbeans.user>${project.build.directory}/test-userdir</netbeans.user>
                    <java.util.prefs.userRoot>${project.build.directory}/test-preferences</java.util.prefs.userRoot>
                </systemPropertyVariables></configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>branding</module>
        <module>application</module>
        <module>ireport-designer</module>
        <module>ireport-standalone-specific</module>
        <module>jasperserver-plugin</module>
        <module>HadoopHive</module>
        <module>heartbeat</module>
        <module>ireport-addons</module>
        <module>ireport-samples</module>
        <module>jasperreports-components</module>
        <module>jasperreports-extensions</module>
        <module>MongoDb</module>
    </modules>

    <properties>
        <netbeans.version>RELEASE310</netbeans.version>
        <brandingToken>ireport</brandingToken>
    </properties>
</project>
